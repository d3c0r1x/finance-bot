{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finance.example.invalid/contracts/events/finance.receipt.v1.schema.json",
  "title": "Finance confirmed receipt snapshot event v1",
  "description": "Outbox snapshot for confirmed receipt lines. Consumers deduplicate by event_id and aggregate_version.",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "schema_version", "tenant_id", "aggregate_type", "aggregate_id", "aggregate_version", "occurred_at", "recorded_at", "producer", "payload"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"const": "receipt.confirmed"},
    "schema_version": {"const": 1},
    "tenant_id": {"type": "string", "format": "uuid"},
    "aggregate_type": {"const": "receipt"},
    "aggregate_id": {"type": "string", "format": "uuid"},
    "aggregate_version": {"type": "integer", "minimum": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "producer": {"const": "core"},
    "correlation_id": {"type": "string", "maxLength": 128},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_user_id", "transaction_id", "receipt_date", "currency", "merchant", "items"],
      "properties": {
        "owner_user_id": {"type": "string", "format": "uuid"},
        "transaction_id": {"type": "string", "format": "uuid"},
        "receipt_date": {"type": "string", "format": "date"},
        "currency": {"const": "RUB"},
        "merchant": {"type": ["string", "null"], "maxLength": 200},
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["item_id", "name", "quantity", "line_sum"],
            "properties": {
              "item_id": {"type": "string", "format": "uuid"},
              "name": {"type": "string", "minLength": 1, "maxLength": 200},
              "quantity": {"type": ["string", "null"], "pattern": "^(?=.*[1-9])[0-9]{1,12}\\.[0-9]{6}$"},
              "line_sum": {"type": ["string", "null"], "pattern": "^(?:0|[1-9][0-9]{0,17})\\.[0-9]{2}$"}
            }
          }
        }
      }
    }
  }
}
