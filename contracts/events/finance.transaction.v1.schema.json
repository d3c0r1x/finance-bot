{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finance.example.invalid/contracts/events/finance.transaction.v1.schema.json",
  "title": "Finance transaction state event v1",
  "description": "Outbox event for a complete transaction state snapshot; consumers deduplicate by event_id and aggregate_version.",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "schema_version", "tenant_id", "aggregate_type", "aggregate_id", "aggregate_version", "occurred_at", "recorded_at", "producer", "payload"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"enum": ["transaction.created", "transaction.updated", "transaction.voided"]},
    "schema_version": {"const": 1},
    "tenant_id": {"type": "string", "format": "uuid"},
    "aggregate_type": {"const": "transaction"},
    "aggregate_id": {"type": "string", "format": "uuid"},
    "aggregate_version": {"type": "integer", "minimum": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "producer": {"const": "core"},
    "correlation_id": {"type": "string", "maxLength": 128},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_user_id", "type", "amount", "currency", "category_code", "status", "financial_occurred_at"],
      "properties": {
        "owner_user_id": {"type": "string", "format": "uuid"},
        "type": {"enum": ["expense", "income", "refund", "debt_payment", "transfer"]},
        "amount": {"type": "string", "pattern": "^(?:0\\.(?:[0-9]?[1-9]|[1-9][0-9])|[1-9][0-9]{0,17}(?:\\.[0-9]{1,2})?)$"},
        "currency": {"const": "RUB"},
        "category_code": {"type": "string", "maxLength": 64},
        "description": {"type": "string", "maxLength": 500},
        "source": {"type": "string", "minLength": 1, "maxLength": 64},
        "status": {"enum": ["posted", "voided"]},
        "financial_occurred_at": {"type": "string", "format": "date-time"},
        "debt_id": {"type": "string", "format": "uuid"},
        "debt_balance_effect": {"type": "string", "pattern": "^\\d+\\.\\d{2}$"}
      }
    }
  }
}
