{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finance.example.invalid/contracts/events/finance.budget.v1.schema.json",
  "title": "Finance budget state event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "schema_version", "tenant_id", "aggregate_type", "aggregate_id", "aggregate_version", "occurred_at", "recorded_at", "producer", "payload"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"enum": ["budget.updated", "budget.deleted"]},
    "schema_version": {"const": 1},
    "tenant_id": {"type": "string", "format": "uuid"},
    "aggregate_type": {"const": "budget"},
    "aggregate_id": {"type": "string", "format": "uuid"},
    "aggregate_version": {"type": "integer", "minimum": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "producer": {"const": "core"},
    "correlation_id": {"type": "string", "maxLength": 128},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["budgetKey", "scope", "amount", "version"],
      "properties": {
        "budgetKey": {"type": "string", "maxLength": 64},
        "period": {"enum": ["monthly", "rolling7"]},
        "scope": {"enum": ["family", "personal"]},
        "amount": {"type": "string", "pattern": "^\\d+\\.\\d{2}$"},
        "active": {"type": "boolean", "description": "Omitted by events produced before reset tombstones; treat as true."},
        "version": {"type": "integer", "minimum": 1}
      }
    }
  }
}
