{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finance.example/contracts/merchant-classification-context.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["merchants"],
  "properties": {
    "merchants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    }
  }
}
