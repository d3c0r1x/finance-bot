{
  "formatVersion": "csv-v1",
  "encoding": "UTF-8",
  "bom": true,
  "delimiter": ";",
  "recordDelimiter": "LF",
  "dateFormat": "yyyy-MM-dd HH:mm",
  "dateTimezone": "requester profile timezone",
  "amountPattern": "^(?:0|[1-9][0-9]{0,17})\\.[0-9]{2}$",
  "formulaEscape": "apostrophe-for-leading-formula-text",
  "formulaPrefixes": ["=", "+", "-", "@"],
  "formulaLeadingWhitespace": " \\t\\r\\n",
  "headers": ["Дата", "Сумма", "Категория", "Подкатегория", "Описание", "Тип", "Долг", "Источник", "Telegram ID"]
}
