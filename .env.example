# Скопируй этот файл в .env и заполни своими значениями
# Токен от @BotFather
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Telegram ID (узнать через @userinfobot)
USER_ID_1=123456789
USER_ID_2=987654321

# ─── Настройки ИИ (опционально) ───
# Вариант A: локальная Ollama (https://ollama.com/download), модель от 3B:
#   ollama pull qwen2.5:7b-instruct
# OLLAMA_MODEL=qwen2.5:7b-instruct
# Если основная модель не скачана, бот сам выберет лучшую из установленных
# (подбор строго по тегу: qwen2.5:7b-instruct не подменится на qwen2.5:7b).
# Новый сервис services/python/intelligence не отправляет данные наружу по умолчанию.
FINANCE_AI_POLICY=local-only
# OLLAMA_HOST=http://localhost:11434
# Только перечисленные здесь модели доступны для задачи receipt-vision; пустое значение
# отключает vision provider. Этот список не включает облако: удалённый host требует
# отдельного FINANCE_AI_POLICY=cloud-opt-in.
# OLLAMA_VISION_MODELS=qwen2.5vl:7b
#
# Вариант B: облако Ollama — ничего ставить не нужно, ключ: https://ollama.com/settings/keys
# Для нового intelligence gateway также нужен явный FINANCE_AI_POLICY=cloud-opt-in.
# OLLAMA_HOST=https://ollama.com
# OLLAMA_API_KEY=твой_ключ
# OLLAMA_MODEL=gpt-oss:20b
#
# Вариант C: Ollama на другой машине в сети
# OLLAMA_HOST=http://192.168.1.50:11434
#
# AI_PARSE_TIMEOUT=90
# AI_ADVICE_TIMEOUT=180
# Сколько дней истории трат нужно, чтобы ИИ предложил бюджет на месяц
# BUDGET_MIN_DAYS=30

# ─── Интерфейс ───
# 1 — заменить «плашку» веб-приложения старого бота штатным меню команд Telegram,
# 0 — не трогать
# HIDE_MENU_BUTTON=1

# ─── Чтение чеков моделью зрения (VLM) ───
# Основной способ: локальная vision-модель читает фото чека целиком (таблица, колонки,
# блёклый и наклонный текст) и понимает, где название, где цена, а где итог.
# Перед чтением фото готовится: обрезается фон, выпрямляется наклон, поднимается резкость.
#   ollama pull qwen3-vl:8b-instruct   (лучшее качество, ~6 ГБ)
#   ollama pull qwen3-vl:4b-instruct   (быстрее, ~3.3 ГБ)
# 1 — читать чеки моделью зрения (по умолчанию), 0 — только Tesseract
# VISION_ENABLED=1
# VISION_MODEL=qwen3-vl:8b-instruct
# Увеличиваем фото перед отправкой — мелкий шрифт читается точнее
# VISION_SCALE=2
# Пауза ожидания ответа модели зрения, секунды (первый запуск грузит модель в память)
# VISION_TIMEOUT=420
# Выгружать текстовую модель из VRAM, пока читает зрение (нужно картам на 12 ГБ),
# после чтения она поднимается обратно в фоне
# VISION_UNLOAD_CHAT=1
# Сколько модель зрения живёт в памяти после чтения чека
# VISION_KEEP_ALIVE=2m
# Второй проход: если позиции не сошлись с итогом чека — перечитать фото другим
# вариантом подготовки и с промптом про таблицу позиций. Стоит примерно одно чтение
# чека, зато дотягивает потерянные строки.
# VISION_SECOND_PASS=1

# ─── OCR и прочее ───
# Tesseract — второй, независимый читатель: проверяет арифметику чека
# (цена × кол-во = сумма) и по недостаче помогает добрать пропущенные позиции.
# Путь можно не указывать: бот сам ищет tesseract.exe в PATH и типичных папках
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# DAILY_REPORT_HOUR=21

# New Python Telegram gateway. Use Redis for shared update deduplication; polling
# can use a process-local fallback for single-instance development only.
FINANCE_TELEGRAM_MODE=polling
# FINANCE_TELEGRAM_BOT_TOKEN=from-secret-store
# FINANCE_REDIS_URL=redis://localhost:6379/0
# FINANCE_TELEGRAM_WEBHOOK_URL=https://finance.example/telegram/webhook
# FINANCE_TELEGRAM_WEBHOOK_SECRET=generate-a-long-random-secret
# FINANCE_TELEGRAM_TLS_CERT=/run/secrets/telegram.crt
# FINANCE_TELEGRAM_TLS_KEY=/run/secrets/telegram.key
# FINANCE_TELEGRAM_PORT=8443
# FINANCE_TELEGRAM_SERVICE_TOKEN=from-secret-store
# FINANCE_CORE_INTERNAL_URL=http://finance-core:8080
# F33 Core-to-Go price history is internal and requires a shared secret.
# ANALYTICS_HTTP_ADDR=0.0.0.0:8090
# FINANCE_ANALYTICS_URL=http://analytics-go:8090
# FINANCE_ANALYTICS_SERVICE_TOKEN=from-secret-store
# FINANCE_ANALYTICS_TIMEOUT=PT5S
# F33 projection worker consumes receipt events and writes the rebuildable ClickHouse projection.
# KAFKA_BROKERS=kafka-1:9093,kafka-2:9093,kafka-3:9093
# KAFKA_RECEIPT_TOPIC=finance.receipts.v1
# KAFKA_PRICE_GROUP_ID=analytics-price-projection-v1
# KAFKA_RECEIPT_DLQ_TOPIC=finance.receipts.v1.dlq
# KAFKA_TLS=true
# KAFKA_USERNAME=from-secret-store
# KAFKA_PASSWORD=from-secret-store
# KAFKA_SASL_MECHANISM=SCRAM-SHA-512
# CLICKHOUSE_URL=https://clickhouse:8443
# CLICKHOUSE_DATABASE=finance_analytics
# CLICKHOUSE_USERNAME=from-secret-store
# CLICKHOUSE_PASSWORD=from-secret-store

# Private receipt photo processing (F10)
# Local filesystem adapter for development; use "s3" with a private bucket in deployments.
FINANCE_RECEIPTS_STORAGE_PROVIDER=filesystem
FINANCE_RECEIPTS_FILESYSTEM_ROOT=./var/receipt-objects
# FINANCE_RECEIPTS_STORAGE_PROVIDER=s3
# FINANCE_RECEIPTS_S3_ENDPOINT=https://s3.example.internal
# FINANCE_RECEIPTS_S3_REGION=us-east-1
# FINANCE_RECEIPTS_S3_BUCKET=finance-receipts-private
# FINANCE_RECEIPTS_S3_ACCESS_KEY=from-secret-store
# FINANCE_RECEIPTS_S3_SECRET_KEY=from-secret-store
# FINANCE_RECEIPTS_S3_PATH_STYLE=true
# FINANCE_CLAMAV_HOST=clamav
# FINANCE_CLAMAV_PORT=3310
# FINANCE_CLAMAV_TIMEOUT=PT10S
# FINANCE_RECEIPT_WORKER_ENABLED=true
# FINANCE_RECEIPT_WORKER_POLL_DELAY=1000
# FINANCE_AI_RECEIPT_OCR_URL=http://finance-python:8000
# FINANCE_AI_RECEIPT_OCR_SERVICE_TOKEN=from-secret-store
# FINANCE_AI_RECEIPT_OCR_TIMEOUT=PT95S
# OLLAMA_VISION_MODELS=qwen3-vl:8b,qwen3-vl:4b
# FINANCE_AI_RECEIPT_VISION_URL=http://finance-python:8000
# FINANCE_AI_RECEIPT_VISION_SERVICE_TOKEN=from-secret-store
# FINANCE_AI_RECEIPT_VISION_TIMEOUT=PT95S
# Private dependency-status probe; defaults to FINANCE_AI_RECEIPT_URL and FINANCE_AI_SERVICE_TOKEN.
# FINANCE_AI_HEALTH_URL=http://finance-python:8091
# FINANCE_AI_HEALTH_SERVICE_TOKEN=from-secret-store
# FINANCE_AI_HEALTH_TIMEOUT=PT3S

# Private CSV export worker (F52). Use a private S3-compatible bucket.
CSV_EXPORT_WORKER_ENABLED=false
CSV_EXPORT_WORKER_POLL_INTERVAL=1s
CSV_EXPORT_WORKER_PAGE_SIZE=500
# CSV_EXPORT_WORKER_TEMP_DIR=/var/tmp/finance-exports
# FINANCE_EXPORTS_SERVICE_TOKEN=from-secret-store
# FINANCE_EXPORTS_S3_ENDPOINT=https://s3.example.internal
# FINANCE_EXPORTS_S3_REGION=us-east-1
# FINANCE_EXPORTS_S3_BUCKET=finance-exports-private
# FINANCE_EXPORTS_S3_ACCESS_KEY=from-secret-store
# FINANCE_EXPORTS_S3_SECRET_KEY=from-secret-store
# FINANCE_EXPORTS_S3_PATH_STYLE=true
